{
  "name": "dersify",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @dersify/database generate",
    "db:migrate": "pnpm --filter @dersify/database migrate:deploy",
    "db:studio": "pnpm --filter @dersify/database studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.11",
      "@types/react-dom": "^18.3.1"
    }
  }
}
